{
  "homepage": "https://DGE83.github.io/portfolio-3d-ia",
  "name": "portfolio-3d-ia",
  "version": "1.0.0",
  "description": "Portfolio pour créations 3D et IA avec un panneau d'administration local.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "build": "node scripts/build.js",
    "watch:build": "nodemon --watch frontend_src -e js,json,css,html,stl,mp4,jpg,png,jpeg,gif --exec \"npm run build\"",
    "serve": "live-server public --port=8080",
    "dev": "npm run build && concurrently \"npm:watch:build\" \"npm:serve\"",       
    "deploy": "gh-pages -d public"
  },
  "author": "Votre Nom",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "gh-pages": "^6.1.1",
    "live-server": "^1.2.2",
    "nodemon": "^3.1.0"
  }
}